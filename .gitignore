# Track LaTeX, documentation, image/font assets, and the build entry point.
# Keep PDFs, portable toolchains, generated output, and local settings on disk.
/*
!/.gitignore
!/*.tex
!/*.sty
!/*.cls
!/*.bib
!/*.bst
!/*.md
!/build.ps1
!/chapters/
/chapters/**
!/chapters/**/
!/chapters/**/*.tex
!/chapters/**/*.sty
!/chapters/**/*.cls
!/chapters/**/*.bib
!/chapters/**/*.bst
!/chapters/**/*.md
!/chapters/**/*.png
!/chapters/**/*.jpg
!/chapters/**/*.jpeg
!/chapters/**/*.gif
!/chapters/**/*.webp
!/chapters/**/*.svg
!/chapters/**/*.eps
!/chapters/**/*.ttf
!/chapters/**/*.otf
!/references/
/references/**
!/references/**/
!/references/**/*.png
!/references/**/*.jpg
!/references/**/*.jpeg
!/references/**/*.gif
!/references/**/*.webp
!/references/**/*.svg
!/references/**/*.eps
